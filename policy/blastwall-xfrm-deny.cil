; Deny XFRM/IPsec control-plane access for the blastwall automation domain.
; Dirty Frag's xfrm-ESP path registers XFRM security associations before
; triggering ESP processing.  Privileged automation should not create or drive
; NETLINK_XFRM state as a default capability.

(deny blastwall_t self (netlink_xfrm_socket
  (accept append bind connect create getattr getopt ioctl listen lock map
   name_bind nlmsg_read nlmsg_write read recv_msg recvfrom relabelfrom
   relabelto send_msg sendto setattr setopt shutdown write)))

(neverallow blastwall_t self (netlink_xfrm_socket
  (accept append bind connect create getattr getopt ioctl listen lock map
   name_bind nlmsg_read nlmsg_write read recv_msg recvfrom relabelfrom
   relabelto send_msg sendto setattr setopt shutdown write)))
