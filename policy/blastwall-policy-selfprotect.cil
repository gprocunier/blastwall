  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))
(neverallow blastwall_t file_context_t (dir
  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))

(deny blastwall_t file_context_t (file
  (append create link lock rename setattr unlink write relabelfrom relabelto)))
(neverallow blastwall_t file_context_t (file
  (append create link lock rename setattr unlink write relabelfrom relabelto)))

(deny blastwall_t selinux_login_config_t (dir
  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))
(neverallow blastwall_t selinux_login_config_t (dir
  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))

(deny blastwall_t selinux_login_config_t (file
  (append create link lock rename setattr unlink write relabelfrom relabelto)))
(neverallow blastwall_t selinux_login_config_t (file
  (append create link lock rename setattr unlink write relabelfrom relabelto)))

(deny blastwall_t semanage_store_t (dir
  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))
(neverallow blastwall_t semanage_store_t (dir
  (add_name create remove_name rename reparent rmdir setattr write
   relabelfrom relabelto)))

(deny blastwall_t semanage_store_t (file
