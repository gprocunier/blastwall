; Lab-only dry-run deny module for the strange-socket-v1 profile.
;
; These optional classes are not present on every RHEL/RHCOS policy build.  The
; module is packaged as payload for lab validation, but is not installed by the
; default Makefile or RPM install path unless the explicit dry-run flag is set.

(optional blastwall_strange_socket_xdp_deny
  (deny blastwall_t self (xdp_socket
    (accept append bind connect create getattr getopt ioctl listen lock map
     name_bind read recv_msg recvfrom relabelfrom relabelto send_msg sendto
     setattr setopt shutdown write)))
  (neverallow blastwall_t self (xdp_socket
    (accept append bind connect create getattr getopt ioctl listen lock map
     name_bind read recv_msg recvfrom relabelfrom relabelto send_msg sendto
     setattr setopt shutdown write))))

