[0.213364, "o", "GROUP:      security-profiles-operator.x-k8s.io"]
[0.000014, "o", "\r"]
[0.000093, "o", "\r\n"]
[0.00009, "o", "KIND:       RawSelinuxProfile\r"]
[0.00003, "o", "\r\n"]
[0.000065, "o", "VERSION:    v1alpha2\r"]
[0.00004, "o", "\r\n"]
[0.000003, "o", "\r"]
[0.000023, "o", "\r\n"]
[0.000003, "o", "FIELD: spec <Object>"]
[0.000075, "o", "\r"]
[0.000136, "o", "\r\n\r\r\n\r\r\nDESCRIPTION:\r\r\n    RawSelinuxProfileSpec defines the desired state of RawSelinuxProfile.\r\r\n    \r\r\nFIELDS:\r\r\n  disabled\t<boolean>\r\r\n    Whether the profile is disabled and should be skipped during reconciliation.\r\r\n\r\r\n  policy\t<string>\r\r\n    <no description>\r\r\n\r\r\n\r\r\n"]
