[4.095313, "o", "\r\n------------------------------------------------------------\r\nblastwall OpenShift/SPO workload confinement with UBI probes\r\n------------------------------------------------------------\r\n"]
[1.100214, "o", "\r\n\r\n>>>\r\n"]
[0.000357, "o", ">>> This recording starts from the bastion checkout. OpenShift is the workload target,\r\n>>> Security Profiles Operator carries the SELinux policy, SCC admission selects the\r\n>>> workload class, and UBI runs the safe probe harness.\r\n"]
[0.000019, "o", ">>>\r\n\r\n"]
