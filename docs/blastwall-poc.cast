[0.000173, "o", "\r\n\u001b[0;33m50:    fd = libc.syscall(ctypes.c_long(nr_bpf),\u001b[0m\r\r\n\u001b[0;33m51:                      ctypes.c_int(BPF_MAP_CREATE),\u001b[0m\r\r\n\u001b[0;33m65:    \"\"\"Attempt BPF_PROG_LOAD with a minimal program (CVE-2026-31525 entry point).\u001b[0m\r\r\n\u001b[0;33m83:    # Build bpf_attr for BPF_PROG_LOAD\u001b[0m\r\r\n\u001b[0;33m100:    fd = libc.syscall(ctypes.c_long(nr_bpf),\u001b[0m\r\r\n\u001b[0;33m101:                      ctypes.c_int(BPF_PROG_LOAD),\u001b[0m\r\r\n\u001b[0;33m135:        print(f\"BLOCKED: bpf(BPF_MAP_CREATE) denied with {map_result}  [CVE-2026-31429, CVE-2025-38154]\")\u001b[0m\r\r\n\u001b[0;33m137:        print(\"FAIL: bpf(BPF_MAP_CREATE) succeeded - policy is NOT denying BPF map creation\")\u001b[0m\r\r\n\u001b[0;33m140:        print(\"%s: bpf(BPF_MAP_CREATE) - %s\" % (map_result, map_result))\u001b[0m\r\r\n\u001b[0;33m143:        print(f\"BLOCKED: bpf(BPF_PROG_LOAD) denied with {prog_result}   [CVE-2026-31525]\")\u001b[0m\r\r\n\u001b[0;33m145:        print(\"FAIL: bpf(BPF_PROG_LOAD) succeeded - policy is NOT denying BPF program loading\")\u001b[0m\r\r\n\u001b[0;33m148:        print(\"%s: bpf(BPF_PROG_LOAD) - %s\" % (prog_result, prog_result))\u001b[0m\r\r\n"]
