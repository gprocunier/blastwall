[0.781975, "o", "\r\r\nPLAY [Prove Blastwall policy self-protection blocks sudo expansion] ************\r\r\n"]
[0.05063, "o", "\r"]
[0.000312, "o", "\r\nTASK [Require IdM admin and automation credentials] ****************************\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"changed\": false,\u001b[0m\r\r\n\u001b[0;32m    \"msg\": \"All assertions passed\"\u001b[0m\r"]
