[0.753485, "o", "\r\r\nTASK [Verify Blastwall deny modules are still installed after failed removal] ***\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan -> mirror-registry.workshop.lan(172.16.0.20)]\u001b[0m\r\r\n"]
[0.068825, "o", "\r\r\n"]
