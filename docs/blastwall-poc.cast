[1.260416, "o", "\u001b[0;33mmirror-registry.workshop.lan | CHANGED | rc=0 >>\u001b[0m\r\r\n\u001b[0;33m2:\"\"\"Safe AF_PACKET socket probe for verifying SELinux packet_socket denial.\u001b[0m\r\r\n\u001b[0;33m4:Attempts to create an AF_PACKET/SOCK_RAW socket, which is the entry\u001b[0m\r\r\n\u001b[0;33m10:    0   BLOCKED  - AF_PACKET socket creation denied with EPERM\u001b[0m\r\r\n\u001b[0;33m13:   77   SKIP     - AF_PACKET not available\u001b[0m\r\r\n\u001b[0;33m21:AF_PACKET = getattr(socket, \"AF_PACKET\", 17)\u001b[0m\r\r\n\u001b[0;33m22:ETH_P_ALL = 0x0003\u001b[0m\r\r\n\u001b[0;33m26:        sock = socket.socket(AF_PACKET, socket.SOCK_RAW, socket.htons(ETH_P_ALL))\u001b[0m\r\r\n\u001b[0;33m29:            print(\"BLOCKED: AF_PACKET socket creation denied with \"\u001b[0m\r\r\n\u001b[0;33m36:            print(\"SKIP: AF_PACKET not supported on this system\")\u001b[0m\r\r\n\u001b[0;33m38:        print(\"INFO: AF_PACKET socket creation failed with %s \"\u001b[0m\r\r\n\u001b[0;33m43:    print(\"FAIL: AF_PACKET socket creation succeeded - \"\u001b[0m\r\r\n"]
