[0.000055, "o", "\r\r\n"]
[0.000249, "o", "\u001b[0;32m    \"msg\": {\u001b[0m\r\r\n\u001b[0;32m        \"afalg_probe\": \"BLOCKED: AF_ALG socket creation denied with errno 13\",\u001b[0m\r\r\n\u001b[0;32m        \"bpf_probe\": \"BLOCKED: bpf(BPF_MAP_CREATE) denied with errno 13  [CVE-2026-31429, CVE-2025-38154]\\nBLOCKED: bpf(BPF_PROG_LOAD) denied with errno 13   [CVE-2026-31525]\",\u001b[0m\r\r\n\u001b[0;32m        \"login_context\": \"blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"packet_socket_probe\": \"BLOCKED: AF_PACKET socket creation denied with errno 13  [CVE-2025-38617, CVE-2026-31504]\",\u001b[0m\r\r\n\u001b[0;32m        \"sudo_context\": \"blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"userns_probe\": \"BLOCKED: unshare(CLONE_NEWUSER) denied with EACCES errno 13  [exploit chain enabler]\"\u001b[0m\r\r\n\u001b[0;32m    }\u001b[0m\r\r\n\u001b[0;32m}\u001b[0m\r\r\n\r\r\nPLAY [Collect audit evidence from automation endpoint] *************************\r\r\n"]
