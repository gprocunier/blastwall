[0.000109, "o", "\r"]
[0.000211, "o", "\r\n\u001b[0;32mok: [bastion-01.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"msg\": {\u001b[0m\r\r\n\u001b[0;32m        \"audit_evidence\": [\u001b[0m\r\r\n\u001b[0;32m            \"type=AVC msg=audit(1777888777.191:46403): avc:  denied  { execute } for  pid=401532 comm=\\\"sesh\\\" name=\\\"semodule\\\" dev=\\\"sda3\\\" ino=9179687 scontext=blastwall_u:blastwall_r:blastwall_t:s0 tcontext=system_u:object_r:semanage_exec_t:s0 tclass=file permissive=0\",\u001b[0m\r\r\n\u001b[0;32m            \"type=AVC msg=audit(1777891652.644:48481): avc:  denied  { execute } for  pid=409742 comm=\\\"sesh\\\" name=\\\"semodule\\\" dev=\\\"sda3\\\" ino=9179687 scontext=blastwall_u:blastwall_r:blastwall_t:s0 tcontext=system_u:object_r:semanage_exec_t:s0 tclass=file permissive=0\",\u001b[0m\r\r\n\u001b[0;32m            \"type=AVC msg=audit(1777930891.707:54950): avc:  denied  { execute } for  pid=441644 comm=\\\"sesh\\\" name=\\\"semodule\\\" dev=\\\"sda3\\\" ino=9179687 scontext=blastwall_u:blastwall_r:blastwall_t:s0 tcontext=system_u:object_r:semanage_exec_t:s0 tclass=file permissive=0\"\u001b[0m\r\r\n\u001b[0;32m        ],\u001b[0m\r\r\n\u001b[0;32m        \"semodule_attempt_rc\": \"1\",\u001b[0m\r\r\n\u001b[0;32m        \"semodule_attempt_stderr\": \"sesh: unable to execute /usr/sbin/semodule: Permission denied\",\u001b[0m\r\r\n\u001b[0;32m        \"sudo_expansion_mode\": \"command_category_all\",\u001b[0m\r\r\n\u001b[0;32m        \"sudo_expansion_seen\": true\u001b[0m\r\r\n\u001b[0;32m    }\u001b[0m\r\r\n\u001b[0;32m}\u001b[0m\r\r\n"]
