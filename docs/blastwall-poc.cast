[0.055228, "o", "\r\r\nTASK [Show Blastwall proof] ****************************************************\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"msg\": {\u001b[0m\r\r\n\u001b[0;32m        \"afalg_probe\": \"BLOCKED: AF_ALG socket creation denied with errno 13\",\u001b[0m\r\r\n\u001b[0;32m        \"bpf_probe\": \"BLOCKED: bpf(BPF_MAP_CREATE) denied with errno 13  [CVE-2026-31429, CVE-2025-38154]\\nBLOCKED: bpf(BPF_PROG_LOAD) denied with errno 13   [CVE-2026-31525]\",\u001b[0m\r\r\n\u001b[0;32m        \"io_uring_probe\": \"BLOCKED: io_uring_setup denied with EPERM  [CVE-2026-43006]\",\u001b[0m\r\r\n\u001b[0;32m        \"login_context\": \"blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"packet_socket_probe\": \"BLOCKED: AF_PACKET socket creation denied with errno 13  [CVE-2025-38617, CVE-2026-31504]\",\u001b[0m\r\r\n\u001b[0;32m        \"sudo_context\": \"blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"userns_probe\": \"BLOCKED: unshare(CLONE_NEWUSER) denied with EACCES errno 13  [exploit chain enabler]\"\u001b[0m\r\r\n\u001b[0;32m    }\u001b[0m\r\r\n\u001b[0;32m}\u001b[0m\r\r\n\r\r\nPLAY [Collect audit evidence from automation endpoint] *************************\r\r\n"]
[0.427123, "o", "\r\r\nTASK [Look for Blastwall syscall denial evidence] ******************************\r\r\n\u001b[0;32mok: [mirror-registry.workshop.lan]\u001b[0m\r\r\n"]
[0.041676, "o", "\r\r\nTASK [Show audit evidence when present] ****************************************\r\r\n\u001b[0;32mok: [mirror-registry.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"blastwall_audit_evidence.stdout_lines\": [\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834938.604:36390) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834938.604:36391) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834938.604:36392) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834940.961:36498) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834941.679:36522) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834941.680:36523) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777834942.379:36547) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansi