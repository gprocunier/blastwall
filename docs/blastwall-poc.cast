[0.000416, "o", "\r\n\u001b[0;33m9:  2. BPF_PROG_LOAD   - entry point for CVE-2026-31525 (interpreter sdiv)\u001b[0m\r\r\n\u001b[0;33m27:BPF_MAP_CREATE = 0\u001b[0m\r\r\n\u001b[0;33m28:BPF_PROG_LOAD = 5\u001b[0m\r\r\n\u001b[0;33m45:    \"\"\"Attempt BPF_MAP_CREATE (CVE-2026-31429, CVE-2025-38154 entry point).\"\"\"\u001b[0m\r\r\n\u001b[0;33m50:    fd = libc.syscall(ctypes.c_long(nr_bpf),\u001b[0m\r\r\n\u001b[0;33m51:                      ctypes.c_int(BPF_MAP_CREATE),\u001b[0m\r\r\n\u001b[0;33m65:    \"\"\"Attempt BPF_PROG_LOAD with a minimal program (CVE-2026-31525 entry point).\u001b[0m\r\r\n\u001b[0;33m83:    # Build bpf_attr for BPF_PROG_LOAD\u001b[0m\r\r\n\u001b[0;33m100:    fd = libc.syscall(ctypes.c_long(nr_bpf),\u001b[0m\r\r\n"]
