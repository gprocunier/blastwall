[0.900771, "o", "\r"]
[0.000177, "o", "\r\nTASK [Read Blastwall HBAC rule through eigenstate.ipa] *************************\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan]\u001b[0m\r\r\n"]
