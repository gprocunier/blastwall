[0.000032, "o", "\r\n"]
[4.328612, "o", "\r\r\nTASK [Add semodule to the Blastwall sudo command group temporarily] ************\r\r\n\u001b[0;33mchanged: [bastion-01.workshop.lan]\u001b[0m\r\r\n"]
