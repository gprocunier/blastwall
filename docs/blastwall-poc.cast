[0.037267, "o", "\r\r\nTASK [Show audit evidence when present] ****************************************\r\r\n\u001b[0;32mok: [mirror-registry.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"blastwall_audit_evidence.stdout_lines\": [\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818313.564:33831) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818313.564:33832) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818313.564:33833) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818315.613:33935) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818316.254:33959) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818316.255:33960) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1777818316.866:33984) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansi