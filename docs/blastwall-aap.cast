[3.512353, "o", "\u001b[0;32m    \"msg\": \"All assertions \u001b[01;31m\u001b[Kpassed\u001b[m\u001b[K\"\u001b[0m\r\r\n\u001b[0;32mok: [localhost] => {\"ansible_facts\": {\"blastwall_credential_hbac_rule\": {\"description\": \"Allow Blastwall automation SSH to automation endpoint\", \"enabled\": true, \"exists\": true, \"groups\": [\"blastwall\"], \"hostcategory\": null, \"hostgroups\": [\"blastwall-managed-hosts\"], \"hosts\": [], \"name\": \"\u001b[01;31m\u001b[Kblastwall-ssh\u001b[m\u001b[K\", \"servicecategory\": null, \"servicegroups\": [], \"services\": [\"sshd\"], \"usercategory\": null, \"users\": []}}, \"changed\": false}\u001b[0m\r\r\n\u001b[0;32m    \"msg\": \"All assertions \u001b[01;31m\u001b[Kpassed\u001b[m\u001b[K\"\u001b[0m\r\r\n\u001b[0;32m        \"\u001b[01;31m\u001b[Kcredential_smoke\u001b[m\u001b[K\": \"\u001b[01;31m\u001b[Kpassed\u001b[m\u001b[K\",\u001b[0m\r\r\n\u001b[0;32m        \"hbac_rule\": \"\u001b[01;31m\u001b[Kblastwall-ssh\u001b[m\u001b[K\",\u001b[0m\r\r\n\u001b[0;32m        \"identity\": \"\u001b[01;31m\u001b[Ksvc-ansible-runner\u001b[m\u001b[K\",\u001b[0m\r\r\n\u001b[0;32m        \"principal\": \"\u001b[01;31m\u001b[Ksvc-ansible-runner\u001b[m\u001b[K\"\u001b[0m\r\r\n"]
