flowchart TB
    AAP["AAP job<br/>automation identity"] --> INV["Inventory facts<br/>eigenstate.ipa reads IdM"]

    subgraph IDM["IdM records"]
      HBAC["HBAC<br/>blastwall-ssh"]
      MARKERS["Host markers<br/>policy version + scopes"]
      MAP["SELinux map<br/>blastwall-root-local-map"]
      SUDO["Sudo rule<br/>blastwall-root-local-sudo"]
    end

    INV --> PREFLIGHT["Preflight gate<br/>access + marker state"]
