    SOURCE["Git policy source<br/>selected branch"]
    FACTS["IdM inventory facts<br/>current markers"]
    BUILD["Build + install<br/>candidate RPM"]
    PROOF{"Host proof<br/>passes?"}
    MARKER["Promote marker<br/>policy version + scopes"]
