[0.000341, "o", "\r\r\n\u001b[0;33m5:kernel entry points the public write-up relies on: NETLINK_XFRM for the\u001b[0m\r\r\n\u001b[0;33m6:xfrm-ESP path and AF_RXRPC for the RxRPC path.  Blastwall should deny both for\u001b[0m\r\r\n\u001b[0;33m7:the confined automation domain.  If AF_RXRPC is absent from the kernel, that\u001b[0m\r\r\n\u001b[0;33m16:import socket\u001b[0m\r\r\n\u001b[0;33m20:NETLINK_XFRM = getattr(socket, \"NETLINK_XFRM\", 6)\u001b[0m\r\r\n"]
[0.00004, "o", "\u001b[0;33m21:AF_RXRPC = getattr(socket, \"AF_RXRPC\", 33)\u001b[0m\r\r\n\u001b[0;33m24:def check_socket(label, family, socktype, proto, skip_errnos=()):\u001b[0m\r\r\n\u001b[0;33m26:        sock = socket.socket(family, socktype, proto)\u001b[0m\r\r\n\u001b[0;33m29:            print(f\"BLOCKED: {label} socket creation denied with errno {exc.errno}\")\u001b[0m\r\r\n\u001b[0;33m41:    print(f\"FAIL: {label} socket creation succeeded\")\u001b[0m\r\r\n\u001b[0;33m47:        check_socket(\u001b[0m\r\r\n\u001b[0;33m48:            \"Dirty Frag NETLINK_XFRM\",\u001b[0m\r\r\n\u001b[0;33m49:            socket.AF_NETLINK,\u001b[0m\r\r\n\u001b[0;33m50:            socket.SOCK_RAW,\u001b[0m\r\r\n\u001b[0;33m51:            NETLINK_XFRM,\u001b[0m\r\r\n\u001b[0;33m53:        check_socket(\u001b[0m\r\r\n\u001b[0;33m54:            \"Dirty Frag AF_RXRPC\",\u001b[0m\r\r\n\u001b[0;33m55:            AF_RXRPC,\u001b[0m\r\r\n\u001b[0;33m56:            socket.SOCK_DGRAM,\u001b[0m\r\r\n"]
