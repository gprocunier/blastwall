[0.000183, "o", "\r\r\n\u001b[0;33m4:Attempts to create a user namespace via unshare(CLONE_NEWUSER).  If\u001b[0m\r\r\n\u001b[0;33m12:    0   BLOCKED  - unshare(CLONE_NEWUSER) denied with EPERM/EACCES\u001b[0m\r"]
[0.000173, "o", "\r\n\u001b[0;33m24:CLONE_NEWUSER = 0x10000000\u001b[0m\r\r\n\u001b[0;33m34:    # Fork first so we don't unshare our own process if it succeeds\u001b[0m\r\r\n\u001b[0;33m37:        # Child: attempt unshare\u001b[0m\r\r\n\u001b[0;33m38:        ret = libc.unshare(ctypes.c_int(CLONE_NEWUSER))\u001b[0m\r\r\n\u001b[0;33m40:            # unshare succeeded, namespace was created\u001b[0m\r\r\n\u001b[0;33m59:        print(\"BLOCKED: unshare(CLONE_NEWUSER) denied with \"\u001b[0m\r\r\n\u001b[0;33m63:        print(\"FAIL: unshare(CLONE_NEWUSER) succeeded - \"\u001b[0m\r\r\n\u001b[0;33m70:        print(\"INFO: unshare(CLONE_NEWUSER) failed with unexpected \"\u001b[0m\r\r\n"]
