[0.054151, "o", "\r\r\nTASK [Show audit evidence when present] ****************************************\r\r\n\u001b[0;32mok: [mirror-registry.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"blastwall_audit_evidence.stdout_lines\": [\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299771.300:225083) syscall=321 exit=-13 comm=\\\"systemd\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299776.158:225174) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299777.177:225197) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299777.177:225198) syscall=321 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=bpf AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299778.118:225221) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299778.984:225244) syscall=272 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=unshare AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299781.139:225289) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\",\u001b[0m\r\r\n\u001b[0;32m        \"type=SYSCALL audit(1778299781.139:225290) syscall=41 exit=-13 comm=\\\"python3\\\" subj=blastwall_u:blastwall_r:blastwall_t:s0\",\u001b[0m\r\r\n\u001b[0;32m        \"ARCH SYSCALL=socket AUID=\\\"svc-ansible-runner\\\"\"\u001b[0m\r\r\n\u001b[0;32m    ]\u001b[0m\r\r\n\u001b[0;32m}\u001b[0m\r\r\n\r\r\nPLAY RECAP *********************************************************************\r\r\n\u001b[0;32mbastion-01.workshop.lan\u001b[0m    : \u001b[0;32mok=18  \u001b[0m changed=0    unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\r\n\u001b[0;33mmirror-registry.workshop.lan\u001b[0m : \u001b[0;32mok=18  \u001b[0m \u001b[0;33mchanged=2   \u001b[0m unreachable=0    failed=0    skipped=0    rescued=0    ignored=0   \r\r\n\r\r\n"]
