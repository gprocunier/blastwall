[0.000666, "o", "\r\n\u001b[0;33m4:Attempts io_uring_setup(2) with a minimal 1-entry submission queue.\u001b[0m\r\r\n\u001b[0;33m12:    0   BLOCKED  - io_uring_setup denied with EPERM\u001b[0m\r\r\n\u001b[0;33m14:    1   FAIL     - io_uring_setup succeeded (policy is NOT protecting)\u001b[0m\r\r\n\u001b[0;33m32:    NR_IO_URING_SETUP = nr_table.get(machine)\u001b[0m\r\r\n\u001b[0;33m33:    if NR_IO_URING_SETUP is None:\u001b[0m\r\r\n\u001b[0;33m47:    fd = libc.syscall(ctypes.c_long(NR_IO_URING_SETUP),\u001b[0m\r\r\n\u001b[0;33m53:        print(\"FAIL: io_uring_setup succeeded - \"\u001b[0m\r\r\n\u001b[0;33m59:        print(\"BLOCKED: io_uring_setup denied with EPERM  [CVE-2026-43006]\")\u001b[0m\r\r\n\u001b[0;33m65:        print(\"INFO: io_uring_setup failed with %s \"\u001b[0m\r\r\n"]
