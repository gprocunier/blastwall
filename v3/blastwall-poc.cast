[0.061258, "o", "\r\r\nTASK [Assert deny modules survived the manipulation attempt] *******************\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan] => {\u001b[0m\r\r\n\u001b[0;32m    \"changed\": false,\u001b[0m\r\r\n\u001b[0;32m    \"msg\": \"All assertions passed\"\u001b[0m\r\r\n\u001b[0;32m}\u001b[0m\r\r\n"]
[1.201827, "o", "\r\r\nTASK [Collect audit evidence for the self-protection denial] *******************\r\r\n\u001b[0;32mok: [bastion-01.workshop.lan -> mirror-registry.workshop.lan(172.16.0.20)]\u001b[0m\r\r\n"]
