[5.968121, "o", "\r\n------------------------------------------------------------\r\nblastwall OpenShift/SPO workload confinement with UBI probes\r\n------------------------------------------------------------\r\n"]
[1.100453, "o", "\r\n\r\n>>>\r\n>>> This recording starts from the bastion checkout. OpenShift is the workload target,\r\n>>> Security Profiles Operator carries the SELinux policy, SCC admission selects the\r\n>>> workload class, and UBI runs the safe probe harness.\r\n>>>\r\n\r\n"]
